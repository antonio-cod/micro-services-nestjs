{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Saúde",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Estado atual dos cinco targets. Verde indica UP, vermelho DOWN e cinza ausência de dados.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" },
            { "options": { "match": "null", "result": { "color": "gray", "text": "NO DATA" } }, "type": "special" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "up{job=~\"api-gateway|users-service|products-service|checkout-service|payments-service\"}", "legendFormat": "{{job}}", "range": true, "refId": "A" }],
      "title": "Status dos serviços",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 3,
      "panels": [],
      "title": "HTTP / RED",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Requisições concluídas por segundo, agrupadas por serviço.",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "id": 4,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "sum by (job) (rate(http_requests_total[$__rate_interval]))", "legendFormat": "{{job}}", "range": true, "refId": "A" }],
      "title": "Throughput geral",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Percentual de respostas HTTP 4xx sobre todas as requisições do mesmo serviço.",
      "fieldConfig": { "defaults": { "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 7 },
      "id": 5,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "100 * sum by (job) (rate(http_requests_total{status_code=~\"4..\"}[$__rate_interval])) / clamp_min(sum by (job) (rate(http_requests_total[$__rate_interval])), 1e-9)", "legendFormat": "{{job}}", "range": true, "refId": "A" }],
      "title": "Taxa de erros 4xx",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Percentual de respostas HTTP 5xx sobre todas as requisições do mesmo serviço.",
      "fieldConfig": { "defaults": { "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 7 },
      "id": 6,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "100 * sum by (job) (rate(http_requests_total{status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum by (job) (rate(http_requests_total[$__rate_interval])), 1e-9)", "legendFormat": "{{job}}", "range": true, "refId": "A" }],
      "title": "Taxa de erros 5xx",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Percentil 95 da latência HTTP calculado a partir dos buckets por serviço.",
      "fieldConfig": { "defaults": { "min": 0, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "id": 7,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{job}}", "range": true, "refId": "A" }],
      "title": "Latência P95",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 8,
      "panels": [],
      "title": "Recursos",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Resident set size máximo observado por serviço.",
      "fieldConfig": { "defaults": { "min": 0, "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "id": 9,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "max by (job) (process_resident_memory_bytes)", "legendFormat": "{{job}}", "range": true, "refId": "A" }],
      "title": "Memória por serviço",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 10,
      "panels": [],
      "title": "Negócio",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Pagamentos que alcançaram estado terminal no período selecionado.",
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 33 },
      "id": 11,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "sum(increase(payments_processed_total{job=\"payments-service\"}[$__range])) or on() vector(0)", "instant": true, "legendFormat": "Processados", "refId": "A" }],
      "title": "Pagamentos processados",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Pagamentos aprovados no período selecionado.",
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 33 },
      "id": 12,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "sum(increase(payments_approved_total{job=\"payments-service\"}[$__range])) or on() vector(0)", "instant": true, "legendFormat": "Aprovados", "refId": "A" }],
      "title": "Pagamentos aprovados",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Pagamentos rejeitados no período selecionado.",
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 33 },
      "id": 13,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "sum(increase(payments_rejected_total{job=\"payments-service\"}[$__range])) or on() vector(0)", "instant": true, "legendFormat": "Rejeitados", "refId": "A" }],
      "title": "Pagamentos rejeitados",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Pedidos persistidos por transações confirmadas no período selecionado.",
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 33 },
      "id": 14,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "sum(increase(orders_created_total{job=\"checkout-service\"}[$__range])) or on() vector(0)", "instant": true, "legendFormat": "Pedidos", "refId": "A" }],
      "title": "Pedidos criados",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Mensagens publicadas com sucesso no período, agrupadas por fila lógica.",
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 33 },
      "id": 15,
      "options": { "displayMode": "gradient", "minVizHeight": 10, "minVizWidth": 0, "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "valueMode": "color" },
      "targets": [{ "editorMode": "code", "expr": "sum by (queue) (increase(rabbitmq_messages_published_total{job=\"checkout-service\"}[$__range]))", "instant": true, "legendFormat": "{{queue}}", "refId": "A" }],
      "title": "Mensagens publicadas",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Pagamentos rejeitados no período, agrupados pelo motivo normalizado.",
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 38 },
      "id": 16,
      "options": { "barRadius": 0, "barWidth": 0.8, "fullHighlight": false, "groupWidth": 0.7, "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "orientation": "auto", "showValue": "auto", "stacking": "none", "tooltip": { "mode": "single", "sort": "none" }, "xTickLabelRotation": 0, "xTickLabelSpacing": 0 },
      "targets": [{ "editorMode": "code", "expr": "sum by (reason) (increase(payments_rejected_total{job=\"payments-service\"}[$__range]))", "instant": true, "legendFormat": "{{reason}}", "refId": "A" }],
      "title": "Rejeições por motivo",
      "type": "barchart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Exibe somente os alertas do marketplace que estão ativos neste momento.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Severidade" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "critical": { "color": "red", "text": "critical" },
                      "info": { "color": "blue", "text": "info" },
                      "warning": { "color": "yellow", "text": "warning" }
                    },
                    "type": "value"
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "mode": "basic", "type": "color-background" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 46 },
      "id": 17,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "ALERTS{alertstate=\"firing\",alertname=~\"ServiceDown|HighErrorRate|HighLatencyP95|HighMemoryUsage|NoPaymentsProcessed|HighPaymentRejectionRate\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Alertas ativos",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true, "__name__": true },
            "indexByName": { "alertname": 0, "severity": 1, "job": 2, "service": 3, "alertstate": 4 },
            "renameByName": {
              "alertname": "Alerta",
              "alertstate": "Estado",
              "job": "Job",
              "service": "Serviço",
              "severity": "Severidade"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 42,
  "tags": ["marketplace-ms", "observability"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Marketplace Overview",
  "uid": "marketplace-overview",
  "version": 1
}
